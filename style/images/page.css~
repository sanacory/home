body {
  color: #eee;
  background: #333333;
  min-width: 600px;
  margin-top: 0px;
  margin-right: auto;
  
  font-family: sans-serif;
  font-weight: normal;
  font-variant: normal;
  font-size: 1em;
  font-style: normal;
  text-decoration: none;
  text-transform: none;
}


small {
  color: #666666;
  font-size: .8em;
}

small.bold {
  font-weight: bold;
}

#header {
	text-align: center; 
        width:600px;
	margin: 15px auto 0 auto;
        border:#777777 2px solid;
}


a {
  color: #aaaaaa;
  font-size: .9em;
  font-family: sans-serif;
}

a:hover {
  color: #5577ff;
}

a.small {
  color: navy;
  font-size: .7em;
}

a:hover.small {
  color: red;
  font-size: .8em;
}



#main {
	margin-top: 15px;
	margin-right: auto;
	margin-left: auto;
        width:800px;
        padding:0 0 0 0;
}


#main #left {
	width: 700px; 
    font-weight: normal;
	font-family: sans-serif;
	font-size:.9em;
}


#main #left table {
	border-collapse: collapse;
	font-size: .9em;
}

#main #left table td {
	padding: 10px 30px 10px 0px; border-top:1px;
	text-align: left;
	vertical-align: top;

}

#main #right {
    font-weight: normal;
	font-family: sans-serif;
	font-size:.9em;
	width: 300px; 
	float: right;
}


#main #right table {
	border-collapse: collapse;
	font-size: .9em;

#footer
{
	text-align: center;
        margin: 0 auto;
        width:800px;
        padding:0;
	font-size: .8em;
        border:#ccc 0px solid;
}


#footer table {
	text-align: center;
	font-size: .9em;
	
}

#footer table td {
	text-align: center;
}


#footer a {
font-size: 1em;
}
